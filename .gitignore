# IDE
.idea/
.vscode/
*.swp
.DS_Store

# Bootstrap local state + credentials (never commit real passwords)
/solution/.bootstrap-state
/solution/.env
/solution/.local/

# Course / local study artifacts
/postgres-learning/data/
/problem.pdf
/practice-sessions.md

# SSH private keys (never commit)
*.pem
*.key
id_rsa
id_ed25519
**/keys/*
!**/keys/.gitkeep
!**/keys/*.pub

# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Terraform variable files (may contain paths / secrets)
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example
